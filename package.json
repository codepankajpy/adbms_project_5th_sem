{
  "name": "vehicle-service-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "npm run --prefix apps/api dev",
    "dev:web": "npm run --prefix apps/web dev",
    "build:api": "npm run --prefix apps/api build",
    "build:web": "npm run --prefix apps/web build",
    "db:migrate": "node apps/api/scripts/migrate.js",
    "db:seed": "node apps/api/scripts/seed.js",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "test:db": "npm run --prefix apps/api test:db"
  }
}
